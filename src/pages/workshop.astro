---
import BaseLayout from "../layouts/BaseLayout.astro";

const items = [
  { n: "poka", kind: "dir", desc: "flagship · open-core · getpoka.app", href: "https://getpoka.app" },
  { n: "tako", kind: "dir", desc: "lab · self-hosted paas · gettako.dev", href: "https://gettako.dev" },
  { n: "laravel-impersonate", kind: "pkg", desc: "login as any user · 300+ stars", href: "https://github.com/octopyid/laravel-impersonate" },
  { n: "rune", kind: "pkg", desc: "cli-first task runner", href: "https://github.com/octopyid/rune" },
  { n: "filament-palette", kind: "pkg", desc: "color palettes for filamentphp", href: "https://github.com/octopyid/filament-palette" },
  { n: "filament-tabify", kind: "pkg", desc: "tabbed widgets for filament", href: "https://github.com/octopyid/filament-tabify" },
  { n: "laravel-inotify", kind: "pkg", desc: "filesystem watcher for laravel", href: "https://github.com/octopyid/laravel-inotify" },
  { n: "octopy-framework", kind: "pkg", desc: "lightweight php framework", href: "https://github.com/octopyid/OctopyFramework" },
];
---

<BaseLayout>
  <section class="relative">
    <div class="mx-auto max-w-4xl px-5 pt-32 pb-24">
      <p class="reveal text-sm text-term-faint">
        <span class="term-prompt font-bold">supian@octopy</span><span class="text-term-faint">:</span><span class="term-path">~</span><span class="text-term-faint">$</span>
        <span class="text-term-text"> find ./workshop -type f | sort</span>
      </p>
      <h1 class="reveal mt-6 font-display text-4xl font-medium tracking-tight md:text-5xl" style="--reveal-delay: 80ms">
        The <em class="font-light text-term-green">workshop.</em>
      </h1>
      <p class="reveal mt-4 max-w-xl text-sm leading-7 text-term-dim" style="--reveal-delay: 140ms">
        Every tool on the shelf — the flagship, the lab, and the open-source line items.
      </p>

      <div class="reveal term-window mt-10 p-2 md:p-3" style="--reveal-delay: 200ms">
        {
          items.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-4 rounded-md px-4 py-3.5 transition-colors hover:bg-term-line/50"
            >
              <p class="text-[15px]">
                <span class="text-term-dim">{item.kind === "dir" ? "drwxr-xr-x" : "-rw-r--r--"}</span>
                <span class={`font-bold ${item.kind === "dir" ? "text-term-cyan" : "text-term-text"} transition-colors group-hover:text-term-green`}>
                  {" "}{item.n}
                </span>
                <span class="ml-3 hidden text-sm text-term-faint sm:inline">{item.desc}</span>
              </p>
              <i class="ph ph-arrow-up-right shrink-0 text-term-faint transition-all group-hover:-translate-y-0.5 group-hover:text-term-green" />
            </a>
          ))
        }
      </div>

      <p class="reveal mt-8 text-sm text-term-faint" style="--reveal-delay: 260ms">
        <span class="text-term-faint">$</span>
        <a href="https://github.com/octopyid" target="_blank" rel="noopener noreferrer" class="text-term-text underline decoration-term-green/50 underline-offset-4 hover:text-term-green">
          ls ~/elsewhere
        </a>
        <span class="text-term-faint"># smaller experiments live on github →</span>
      </p>
    </div>
  </section>
</BaseLayout>
