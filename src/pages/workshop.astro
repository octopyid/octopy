---
import BaseLayout from "../layouts/BaseLayout.astro";

const boxes = [
  {
    n: "001",
    title: "Poka",
    tag: "Flagship",
    tagColor: "text-marker",
    desc: "Offline-first personal finance. Open-core to its bones — the Community Edition lives on GitHub under Apache 2.0, and the Premium tier is in Google Play review.",
    tags: ["Finance", "Offline-first", "Open-core"],
    links: [
      { label: "getpoka.app", href: "https://getpoka.app" },
      { label: "GitHub", href: "https://github.com/getpoka/poka-ce" },
    ],
    featured: true,
  },
  {
    n: "002",
    title: "Tako",
    tag: "Lab",
    tagColor: "text-pen",
    desc: "Self-hosted platform-as-a-service — a Dokploy-style control plane for shipping apps on your own servers.",
    tags: ["PaaS", "Self-hosted"],
    links: [{ label: "gettako.dev", href: "https://gettako.dev" }],
  },
  {
    n: "003",
    title: "laravel-impersonate",
    tag: "Open source",
    tagColor: "text-ink-faint",
    desc: "Log in as any user in Laravel apps. 300+ stars on GitHub.",
    tags: ["Laravel", "Auth"],
    links: [{ label: "GitHub", href: "https://github.com/octopyid/laravel-impersonate" }],
  },
  {
    n: "004",
    title: "rune",
    tag: "Open source",
    tagColor: "text-ink-faint",
    desc: "CLI-first task runner. Tasks as commands, not shell recipes.",
    tags: ["Go", "CLI"],
    links: [{ label: "GitHub", href: "https://github.com/octopyid/rune" }],
  },
  {
    n: "005",
    title: "filament-palette",
    tag: "Open source",
    tagColor: "text-ink-faint",
    desc: "Custom color palettes for FilamentPHP.",
    tags: ["Laravel", "Filament"],
    links: [{ label: "GitHub", href: "https://github.com/octopyid/filament-palette" }],
  },
  {
    n: "006",
    title: "filament-tabify",
    tag: "Open source",
    tagColor: "text-ink-faint",
    desc: "Tabbed widgets for Filament dashboards.",
    tags: ["Laravel", "Filament"],
    links: [{ label: "GitHub", href: "https://github.com/octopyid/filament-tabify" }],
  },
  {
    n: "007",
    title: "laravel-inotify",
    tag: "Open source",
    tagColor: "text-ink-faint",
    desc: "Filesystem watcher for Laravel.",
    tags: ["Laravel"],
    links: [{ label: "GitHub", href: "https://github.com/octopyid/laravel-inotify" }],
  },
  {
    n: "008",
    title: "OctopyFramework",
    tag: "Open source",
    tagColor: "text-ink-faint",
    desc: "Lightweight PHP framework, Laravel look-alike. Where it all started.",
    tags: ["PHP", "MVC"],
    links: [{ label: "GitHub", href: "https://github.com/octopyid/OctopyFramework" }],
  },
];
---

<BaseLayout>
  <section class="relative">
    <div class="mx-auto max-w-6xl px-5 pt-36 pb-24 md:pt-44">
      <p
        class="reveal flex items-center gap-3 font-mono text-[11px] tracking-[0.3em] text-ink-faint uppercase"
      >
        <span class="inline-block h-px w-10 bg-ink/30"></span>
        Octopy &mdash; The workshop
      </p>
      <h1
        class="reveal mt-6 font-display text-4xl font-medium tracking-tight text-ink md:text-6xl"
        style="--reveal-delay: 90ms"
      >
        Everything on <em class="font-light">the shelves.</em>
      </h1>
      <p
        class="reveal mt-5 max-w-xl leading-relaxed text-ink-soft"
        style="--reveal-delay: 160ms"
      >
        The full inventory &mdash; the flagship, the lab experiments, and the open-source tools.
        Boxed, labeled, and kept in working order.
      </p>

      <div class="mt-14 grid gap-8 md:grid-cols-3 md:gap-6">
        {
          boxes.map((box, i) => (
            <article
              class={`reveal work-card relative flex flex-col p-7 transition-transform duration-300 hover:-translate-y-1 ${
                box.featured ? "md:col-span-2" : ""
              }`}
              style={`--reveal-delay: ${(i % 3) * 100}ms`}
            >
              {box.featured && <div class="tape -top-3.5 left-10 -rotate-3" />}
              <div class="flex items-start justify-between gap-4">
                <p class="font-mono text-[10px] tracking-[0.25em] text-ink-faint uppercase">
                  Box N&ordm; {box.n}
                </p>
                <span class={`stamp ${box.tagColor}`}>{box.tag}</span>
              </div>
              <h2 class="mt-6 font-display text-2xl font-medium tracking-tight text-ink md:text-3xl">
                {box.title}
              </h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{box.desc}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {box.tags.map((t) => (
                  <span class="rounded-sm border border-ink/12 px-2.5 py-1 font-mono text-[11px] text-ink-soft">
                    {t}
                  </span>
                ))}
              </div>
              <div class="mt-6 flex flex-wrap gap-5 border-t border-dashed border-ink/15 pt-5 font-mono text-sm">
                {box.links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-ink underline decoration-marker/50 decoration-2 underline-offset-4 transition-colors hover:text-marker"
                  >
                    {l.label} <i class="ph ph-arrow-up-right" />
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <p class="reveal mt-12 text-center font-mono text-sm text-ink-faint">
        Smaller experiments and one-off tools live on{" "}
        <a
          href="https://github.com/octopyid"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink underline decoration-marker/60 decoration-2 underline-offset-4 transition-colors hover:text-marker"
        >
          GitHub <i class="ph ph-arrow-up-right" />
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
