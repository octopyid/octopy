---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout>
  <section class="relative">
    <div class="mx-auto max-w-4xl px-5 pt-36 pb-24 md:pt-44">
      <p
        class="reveal font-mono text-[11px] tracking-[0.3em] text-ink-faint uppercase"
      >
        Appendix B &mdash; Field notes
      </p>
      <h1
        class="reveal mt-6 font-display text-4xl font-medium tracking-tight text-ink md:text-6xl"
        style="--reveal-delay: 90ms"
      >
        Notes from <em class="font-light">the year.</em>
      </h1>
      <p
        class="reveal mt-5 max-w-xl leading-relaxed text-ink-soft"
        style="--reveal-delay: 160ms"
      >
        Occasional writing on building software and running servers. Filed here for the
        record.
      </p>

      <div class="mt-14 border-t border-ink/15">
        {
          notes.map((note, i) => (
            <a
              href={`/notes/${note.id.replace(/\.md$/, "")}`}
              class="reveal group flex items-baseline justify-between gap-6 border-b border-ink/10 py-7"
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <div class="toc-row flex-1">
                <div>
                  <p class="font-mono text-[11px] tracking-[0.2em] text-ink-faint uppercase">
                    {fmt(note.data.date)}
                    {note.data.readTime && ` · ${note.data.readTime} min`}
                  </p>
                  <h2 class="mt-2 font-display text-2xl font-medium tracking-tight text-ink transition-colors group-hover:text-ledger md:text-3xl">
                    {note.data.title}
                  </h2>
                </div>
                <span class="toc-leader hidden sm:block" aria-hidden="true" />
              </div>
              <i class="ph ph-arrow-right shrink-0 text-xl text-ink-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-ledger" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
