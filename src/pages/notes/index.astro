---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout>
  <section class="relative">
    <div class="mx-auto max-w-4xl px-5 pt-32 pb-24">
      <p class="reveal text-sm text-term-faint">
        <span class="term-prompt font-bold">supian@octopy</span><span class="text-term-faint">:</span><span class="term-path">~/notes</span><span class="text-term-faint">$</span>
        <span class="text-term-text"> ls</span>
      </p>
      <h1 class="reveal mt-6 font-display text-4xl font-medium tracking-tight md:text-5xl" style="--reveal-delay: 80ms">
        Field <em class="font-light text-term-green">notes.</em>
      </h1>
      <p class="reveal mt-4 max-w-xl text-sm leading-7 text-term-dim" style="--reveal-delay: 140ms">
        Occasional writing on building software and running servers. No schedule, no
        newsletter.
      </p>

      <div class="mt-12 space-y-5">
        {
          notes.map((note, i) => (
            <a
              href={`/notes/${note.id.replace(/\.md$/, "")}`}
              class="reveal term-window group block p-6 transition-transform duration-300 hover:-translate-y-0.5"
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <p class="font-mono text-[11px] tracking-[0.2em] text-term-faint uppercase">
                {fmt(note.data.date)}
                {note.data.readTime && ` · ${note.data.readTime} min read`}
              </p>
              <h2 class="mt-3 font-display text-2xl font-medium tracking-tight transition-colors group-hover:text-term-green">
                {note.data.title}
              </h2>
              {note.data.description && (
                <p class="mt-2.5 text-sm leading-7 text-term-dim">{note.data.description}</p>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
