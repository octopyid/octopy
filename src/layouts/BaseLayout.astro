---
import "../styles/global.css";

const title = "Octopy — Independent Software Studio";
const description =
  "Octopy is an independent software studio building reliable web applications and server infrastructure. Home of Poka.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f3edde" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%231c1a16'/%3E%3Ctext x='50' y='70' font-size='60' text-anchor='middle' fill='%23f3edde' font-family='Georgia'%3EO%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Space+Grotesk:wght@300..700&family=JetBrains+Mono:wght@400;500&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <nav
      class="fixed inset-x-0 top-0 z-50 border-b border-ink/10 bg-paper/85 backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="#bench" class="font-display text-xl font-semibold tracking-tight text-ink"
          >Octopy</a
        >
        <div
          class="hidden items-center gap-8 font-mono text-[11px] tracking-[0.22em] text-ink-soft uppercase sm:flex"
        >
          <a href="#bench" class="transition-colors hover:text-marker">Bench</a>
          <a href="#work" class="transition-colors hover:text-marker">Work</a>
          <a href="#toolbox" class="transition-colors hover:text-marker">Toolbox</a>
          <a href="#maker" class="transition-colors hover:text-marker">Maker</a>
          <a href="#contact" class="transition-colors hover:text-marker">Contact</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
