---
// $ ./contact.sh
---
<section id="contact" class="relative border-t border-term-line bg-term-panel/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <p class="reveal text-sm text-term-faint">
      <span class="term-prompt font-bold">supian@octopy</span><span class="text-term-faint">:</span><span class="term-path">~</span><span class="text-term-faint">$</span>
      <span class="text-term-text"> ./contact.sh</span>
    </p>

    <div class="reveal term-window mt-8 max-w-2xl p-6 md:p-8" style="--reveal-delay: 100ms">
      <p class="text-term-dim">[ok] channel open — the inbox is read by the founder himself.</p>
      <p class="text-term-dim">[ok] allow one business day. there is no support team to escalate to.</p>
      <p class="mt-6 text-sm text-term-faint">$ mailto</p>
      <a
        href="mailto:supianidz@octopy.dev?subject=Hello%20Octopy"
        class="mt-2 inline-block font-display text-3xl tracking-tight text-term-text underline decoration-term-green/60 decoration-2 underline-offset-8 transition-colors hover:text-term-green md:text-4xl"
      >
        supianidz@octopy.dev
      </a>

      <p class="mt-8 text-sm text-term-faint">$ ls ~/elsewhere</p>
      <div class="mt-4 flex items-center gap-4">
        <a
          href="https://github.com/supianidz"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex h-11 w-11 items-center justify-center rounded-md border border-term-line text-term-dim transition-all duration-300 hover:-translate-y-0.5 hover:border-term-green/60 hover:text-term-green"
        >
          <i class="ph-duotone ph-github-logo text-xl"></i>
        </a>
        <a
          href="https://linkedin.com/in/supianidz"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex h-11 w-11 items-center justify-center rounded-md border border-term-line text-term-dim transition-all duration-300 hover:-translate-y-0.5 hover:border-term-green/60 hover:text-term-green"
        >
          <i class="ph-duotone ph-linkedin-logo text-xl"></i>
        </a>
        <a
          href="https://wa.me/628159826697?text=Hello%20Supian%2C%20I%20would%20like%20to%20discuss%20a%20project."
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="flex h-11 w-11 items-center justify-center rounded-md border border-term-line text-term-dim transition-all duration-300 hover:-translate-y-0.5 hover:border-term-green/60 hover:text-term-green"
        >
          <i class="ph-duotone ph-whatsapp-logo text-xl"></i>
        </a>
      </div>
    </div>
  </div>

  <footer class="border-t border-term-line">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-6 font-mono text-[11px] text-term-faint sm:flex-row">
      <span>© 2026 octopy · supian m. — all rights reserved</span>
      <span>
        <a href="/notes" class="underline decoration-term-line underline-offset-4 transition-colors hover:text-term-text">field notes</a>
        <span class="mx-2">·</span>
        <a href="/workshop" class="underline decoration-term-line underline-offset-4 transition-colors hover:text-term-text">workshop</a>
        <span class="mx-2">·</span>
        uptime: 10 years · load average: 1 human
      </span>
    </div>
  </footer>
</section>
