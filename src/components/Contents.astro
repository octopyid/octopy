---
// Table of contents.
const items = [
  { n: "01", title: "Letter from the Founder", href: "#letter" },
  { n: "02", title: "By the Numbers", href: "#numbers" },
  { n: "03", title: "Holdings", href: "#holdings" },
  { n: "04", title: "Open Source", href: "#opensource" },
  { n: "05", title: "Outlook", href: "#outlook" },
];
---
<section id="contents" class="relative border-t border-ink/10">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <p
      class="reveal font-mono text-[11px] tracking-[0.3em] text-ink-faint uppercase"
    >
      Contents
    </p>
    <nav class="mt-8">
      <ul>
        {
          items.map((item, i) => (
            <li class="reveal border-b border-ink/10" style={`--reveal-delay: ${i * 70}ms`}>
              <a href={item.href} class="toc-row group py-5">
                <span class="font-mono text-sm text-ledger">{item.n}</span>
                <span class="font-display text-2xl font-medium tracking-tight text-ink transition-colors group-hover:text-ledger md:text-3xl">
                  {item.title}
                </span>
                <span class="toc-leader" aria-hidden="true" />
                <i class="ph ph-arrow-down-right text-xl text-ink-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-ledger" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
