---
// Twilight Zone resident — a drifting jellyfish, drawn as faint glowing line-art.
---
<div
  class="pointer-events-none absolute top-14 right-6 z-0 hidden w-36 opacity-40 md:right-20 md:block md:w-52"
  aria-hidden="true"
>
  <div class="float-slow" style="animation-delay: -2s">
    <svg
      viewBox="0 0 200 300"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      class="text-glow-300 drop-shadow-[0_0_14px_rgba(79,227,193,0.45)]"
    >
      <path d="M40 100 A60 60 0 0 1 160 100" />
      <path d="M62 100 A38 38 0 0 1 138 100" opacity="0.45" />
      <path d="M40 100 L160 100" opacity="0.6" />
      <path d="M65 100 C60 140 70 175 64 215 C60 242 66 262 62 282" />
      <path d="M85 100 C83 145 88 185 85 232" />
      <path d="M100 100 C100 150 98 200 100 252" />
      <path d="M115 100 C117 145 112 185 115 232" />
      <path d="M135 100 C140 140 130 175 136 215 C140 242 134 262 138 282" />
    </svg>
  </div>
</div>
