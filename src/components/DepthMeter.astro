---
// Fixed depth gauge on the right edge. Updated by the layout script on scroll.
---
<div
  id="depth-meter"
  class="fixed top-1/2 right-4 z-40 hidden -translate-y-1/2 md:right-8 md:block"
  aria-hidden="true"
>
  <div class="flex flex-col items-center gap-3">
    <span
      id="depth-zone"
      class="font-mono text-[10px] tracking-[0.25em] uppercase [writing-mode:vertical-rl] rotate-180"
      >The Surface</span
    >
    <div class="meter-track relative h-44 w-px">
      <span
        id="depth-dot"
        class="absolute top-0 left-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-glow-400 shadow-[0_0_14px_3px_rgba(79,227,193,0.7)]"
      ></span>
    </div>
    <span id="depth-value" class="font-mono text-[10px] [writing-mode:vertical-rl] rotate-180"
      >−0 m</span
    >
  </div>
</div>
