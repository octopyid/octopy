---
// Services — what the bench takes on.
const services = [
  {
    icon: "ph-code",
    title: "Backend development",
    desc: "Laravel APIs and web applications. Payments, registrations, reporting — the systems that have to work every day.",
  },
  {
    icon: "ph-shield-check",
    title: "Infrastructure & hardening",
    desc: "Linux servers provisioned and hardened: WAF, mail stacks, queues, backups. Handed over running, not half-done.",
  },
  {
    icon: "ph-package",
    title: "Open-source packages",
    desc: "Custom Laravel packages, built and maintained in the open. Have a package idea? Let's talk.",
  },
];
---
<section id="services" class="relative">
  <div class="relative z-10 mx-auto max-w-6xl px-5 py-24 md:py-32">
    <p
      class="reveal flex items-center gap-3 font-mono text-[11px] tracking-[0.3em] text-ink-faint uppercase"
    >
      <span class="inline-block h-px w-10 bg-ink/30"></span>
      Station 04 &mdash; Services
    </p>
    <h2
      class="reveal mt-6 font-display text-4xl font-medium tracking-tight text-ink md:text-6xl"
      style="--reveal-delay: 90ms"
    >
      Work we <em class="font-light">take on.</em>
    </h2>
    <p
      class="reveal mt-5 max-w-xl leading-relaxed text-ink-soft"
      style="--reveal-delay: 160ms"
    >
      Client work happens on the same bench as our products &mdash; scoped honestly, built to
      run quietly in production.
    </p>

    <div class="mt-14 grid gap-8 md:grid-cols-3 md:gap-6">
      {
        services.map((s, i) => (
          <div
            class="reveal work-card relative p-7 transition-transform duration-500 hover:-translate-y-1"
            style={`--reveal-delay: ${i * 110}ms`}
          >
            <div class={`tape -top-3.5 left-8 ${i === 1 ? "rotate-2" : "-rotate-3"}`}></div>
            <div class="flex h-12 w-12 items-center justify-center rounded-sm bg-ink text-paper">
              <i class={`ph-duotone ${s.icon} text-2xl`}></i>
            </div>
            <h3 class="mt-6 font-display text-2xl font-medium tracking-tight text-ink">
              {s.title}
            </h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
