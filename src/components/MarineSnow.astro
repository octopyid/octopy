---
// Marine snow: tiny drifting particles, like the real ocean.
---
<canvas id="marine-snow" class="pointer-events-none fixed inset-0 z-[3]" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("marine-snow") as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !reduceMotion) {
    const ctx = canvas.getContext("2d");
    let w = 0;
    let h = 0;
    let flakes: { x: number; y: number; r: number; speed: number; phase: number; alpha: number; teal: boolean }[] = [];

    function resize() {
      w = canvas!.width = window.innerWidth;
      h = canvas!.height = window.innerHeight;
      const count = Math.min(110, Math.floor(w / 13));
      flakes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.6 + Math.random() * 1.8,
        speed: 0.12 + Math.random() * 0.5,
        phase: Math.random() * Math.PI * 2,
        alpha: 0.12 + Math.random() * 0.4,
        teal: Math.random() < 0.3,
      }));
    }

    resize();
    window.addEventListener("resize", resize);

    let t = 0;
    function tick() {
      t += 0.008;
      ctx!.clearRect(0, 0, w, h);
      for (const f of flakes) {
        f.y += f.speed;
        f.x += Math.sin(t * 2 + f.phase) * 0.25;
        if (f.y > h + 4) {
          f.y = -4;
          f.x = Math.random() * w;
        }
        const twinkle = f.alpha * (0.7 + 0.3 * Math.sin(t * 3 + f.phase));
        ctx!.beginPath();
        ctx!.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx!.fillStyle = f.teal ? `rgba(125, 240, 216, ${twinkle})` : `rgba(255, 255, 255, ${twinkle})`;
        ctx!.fill();
      }
      requestAnimationFrame(tick);
    }
    tick();
  }
</script>
