---
// 02 — By the Numbers. Honest figures only.
const kpis = [
  { value: "10", label: "Open-source packages maintained" },
  { value: "300+", label: "GitHub stars on laravel-impersonate" },
  { value: "10", label: "Years building software" },
  { value: "2", label: "Products in the portfolio" },
  { value: "1", label: "Person on the team" },
  { value: "$0", label: "Outside funding raised" },
];

// Verified via the GitHub API, October 2026.
const bars = [
  { name: "laravel-impersonate", stars: 326 },
  { name: "OctopyFramework", stars: 58 },
  { name: "GPhotoCLI", stars: 21 },
  { name: "laravel-inotify", stars: 13 },
  { name: "filament-palette", stars: 13 },
];
const max = Math.max(...bars.map((b) => b.stars));
---
<section id="numbers" class="relative border-t border-ink/10">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <p class="reveal font-mono text-[11px] tracking-[0.3em] text-ink-faint uppercase">
      02 &mdash; By the Numbers
    </p>
    <h2
      class="reveal mt-6 font-display text-4xl font-medium tracking-tight text-ink md:text-5xl"
      style="--reveal-delay: 80ms"
    >
      The year in <em class="font-light">figures.</em>
    </h2>

    <div class="mt-12 grid grid-cols-2 gap-px bg-ink/15 md:grid-cols-3">
      {
        kpis.map((kpi, i) => (
          <div class="reveal bg-paper p-7 md:p-9" style={`--reveal-delay: ${i * 60}ms`}>
            <p class="font-mono text-4xl font-medium tracking-tight text-ink md:text-5xl">
              {kpi.value}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{kpi.label}</p>
          </div>
        ))
      }
    </div>
    <p class="reveal mt-4 font-mono text-[11px] text-ink-faint">
      Figures as of October 2026. The last one is a point of pride.
    </p>

    <div class="mt-16 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h3 class="reveal font-display text-2xl font-medium tracking-tight text-ink">
          Stars by package
        </h3>
        <div class="mt-6 space-y-5">
          {
            bars.map((bar, i) => (
              <div class="reveal" style={`--reveal-delay: ${i * 70}ms`}>
                <div class="flex items-baseline justify-between gap-4">
                  <p class="font-mono text-sm text-ink">{bar.name}</p>
                  <p class="font-mono text-sm text-ink-faint">{bar.stars}</p>
                </div>
                <div class="mt-2 h-2.5 w-full bg-ink/10">
                  <div class="h-full bg-ledger" style={`width: ${(bar.stars / max) * 100}%`} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="md:col-span-5">
        <h3 class="reveal font-display text-2xl font-medium tracking-tight text-ink">
          Notes to the figures
        </h3>
        <ul class="reveal mt-6 space-y-4 text-[15px] leading-relaxed text-ink-soft" style="--reveal-delay: 100ms">
          <li class="flex gap-3">
            <span class="font-mono text-ledger">*</span>
            Star counts are vanity-adjacent, but they measure something real: strangers trusting
            the code enough to keep it.
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-ledger">*</span>
            &ldquo;Years building&rdquo; counts a decade across software and Linux systems &mdash;
            government, private clients, and nights.
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-ledger">*</span>
            Zero outside funding is reported the way it is: as independence, fully owned.
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
