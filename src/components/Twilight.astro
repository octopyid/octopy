---
// ZONE 2 — Twilight Zone. The products, glowing faintly in the dim water.
import Jellyfish from "./Jellyfish.astro";
---
<section
  id="twilight"
  class="relative overflow-hidden bg-gradient-to-b from-twilight-700 via-twilight-800 to-[#04121f]"
>
  <Jellyfish />
  <div
    class="float-slow absolute top-24 -left-24 h-96 w-96 rounded-full bg-glow-500/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="float-slow absolute right-0 bottom-40 h-80 w-80 rounded-full bg-glow-400/10 blur-[110px]"
    style="animation-delay: -4s"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-5 py-28 md:py-40">
    <p class="reveal font-mono text-[11px] tracking-[0.3em] text-glow-300/70 uppercase">
      &minus;200 m &middot; Twilight Zone
    </p>
    <h2
      class="reveal mt-6 font-display text-4xl leading-tight font-medium tracking-tight text-foam-50 md:text-6xl"
      style="--reveal-delay: 90ms"
    >
      Built below<br />the <em class="font-light text-glow-300">surface.</em>
    </h2>
    <p
      class="reveal mt-6 max-w-xl leading-relaxed text-foam-100/60"
      style="--reveal-delay: 180ms"
    >
      What the studio has shipped so far &mdash; a flagship product, and the lab it came from.
    </p>

    <div class="mt-14 grid gap-6 md:grid-cols-5">
      <!-- Poka — flagship -->
      <article
        class="reveal group rounded-3xl border border-white/10 bg-white/[0.04] p-8 backdrop-blur-sm transition-colors duration-500 hover:border-glow-400/40 md:col-span-3 md:p-10"
      >
        <div class="flex items-start justify-between gap-4">
          <div
            class="flex h-13 w-13 items-center justify-center rounded-2xl border border-glow-400/30 bg-glow-400/10 p-3"
          >
            <i class="ph-duotone ph-device-mobile text-3xl text-glow-300"></i>
          </div>
          <span
            class="rounded-full border border-glow-400/40 px-3.5 py-1.5 font-mono text-[10px] tracking-[0.25em] text-glow-300 uppercase"
            >Flagship</span
          >
        </div>
        <h3 class="mt-7 font-display text-3xl font-medium tracking-tight text-foam-50 md:text-4xl">
          Poka
        </h3>
        <p class="mt-4 leading-relaxed text-foam-100/60">
          Our flagship product. Open-core to its bones &mdash; the Community Edition lives on
          GitHub under Apache 2.0, and the Premium tier is making its way through Google Play
          review.
        </p>
        <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px] text-foam-100/50">
          <span class="rounded-full border border-white/10 px-3 py-1">Open-core</span>
          <span class="rounded-full border border-white/10 px-3 py-1">Apache 2.0</span>
          <span class="rounded-full border border-white/10 px-3 py-1">Flutter</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-6 font-mono text-sm">
          <a
            href="https://getpoka.app"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-glow-300 transition-opacity hover:opacity-80"
          >
            getpoka.app <i class="ph ph-arrow-up-right"></i>
          </a>
          <a
            href="https://github.com/getpoka/poka-ce"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-foam-100/60 transition-colors hover:text-foam-50"
          >
            <i class="ph ph-github-logo text-base"></i> poka-ce
          </a>
        </div>
      </article>

      <!-- Tako — the lab -->
      <article
        class="reveal group rounded-3xl border border-white/10 bg-white/[0.03] p-8 backdrop-blur-sm transition-colors duration-500 hover:border-glow-400/30 md:col-span-2 md:p-10"
        style="--reveal-delay: 120ms"
      >
        <div class="flex items-start justify-between gap-4">
          <div
            class="flex h-13 w-13 items-center justify-center rounded-2xl border border-white/15 bg-white/5 p-3"
          >
            <i class="ph-duotone ph-hard-drives text-3xl text-foam-100/80"></i>
          </div>
          <span
            class="rounded-full border border-white/15 px-3.5 py-1.5 font-mono text-[10px] tracking-[0.25em] text-foam-100/60 uppercase"
            >The lab</span
          >
        </div>
        <h3 class="mt-7 font-display text-3xl font-medium tracking-tight text-foam-50">Tako</h3>
        <p class="mt-4 leading-relaxed text-foam-100/60">
          Our self-hosted platform-as-a-service &mdash; a Dokploy-style control plane for shipping
          apps on your own servers. The workshop where Octopy&rsquo;s infrastructure ideas get
          their sea legs.
        </p>
        <div class="mt-8 font-mono text-sm">
          <a
            href="https://gettako.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-foam-100/60 transition-colors hover:text-foam-50"
          >
            gettako.dev <i class="ph ph-arrow-up-right"></i>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
