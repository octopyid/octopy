---
// ProofStrip — the numbers, ledger-style. Every figure is real.
const stats = [
  { value: "300+", label: "GitHub stars" },
  { value: "16", label: "Open-source repos" },
  { value: "2", label: "Products shipped" },
  { value: "5", label: "Client engagements" },
];
---

<section aria-label="Octopy in numbers" class="border-y border-dashed border-ink/15">
  <div class="mx-auto grid max-w-6xl grid-cols-2 md:grid-cols-4">
    {
      stats.map((s) => (
        <div class="px-6 py-6 text-center md:py-7">
          <p class="font-display text-3xl font-medium tracking-tight text-ink md:text-4xl">
            {s.value}
          </p>
          <p class="mt-1.5 font-mono text-[11px] tracking-[0.2em] text-ink-faint uppercase">
            {s.label}
          </p>
        </div>
      ))
    }
  </div>
</section>
